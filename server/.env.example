# Server
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# Email recipient (your inbox)
CONTACT_RECIPIENT_EMAIL=you@example.com

# SMTP account used to send inquiry notifications.
# Gmail example: smtp.gmail.com, port 465, secure true, and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM="Portfolio Inquiries <you@example.com>"
